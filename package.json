{
  "name": "saffron",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @saffron/web build && pnpm --filter @saffron/server dev",
    "dev:web": "pnpm --filter @saffron/web dev",
    "build": "pnpm --filter @saffron/web build",
    "ship": "pnpm build && pnpm --filter @saffron/server run deploy",
    "assets": "./scripts/build-assets.sh",
    "sim": "pnpm --filter @saffron/bot sim",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
